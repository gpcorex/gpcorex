[Unit]
Description=OpenAI Secure MCP Tunnel for Sistema
After=network-online.target sistema-mcp.service
Wants=network-online.target
Requires=sistema-mcp.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/sistema/tunnel.env
ExecStart=/usr/local/bin/tunnel-client run --control-plane.tunnel-id=${CONTROL_PLANE_TUNNEL_ID} --control-plane.api-key=env:CONTROL_PLANE_API_KEY --mcp.server-url=${MCP_SERVER_URL}
Restart=always
RestartSec=5
StartLimitIntervalSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu /var/log
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
