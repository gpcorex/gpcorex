[Unit]
Description=OpenAI Secure MCP Tunnel for Sistema
After=network-online.target sistema-mcp.service
Wants=network-online.target
Requires=sistema-mcp.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
EnvironmentFile=/etc/sistema/tunnel.env
ExecStart=/usr/local/bin/tunnel-client run --profile sistema
Restart=always
RestartSec=5
StartLimitIntervalSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu /var/log
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
